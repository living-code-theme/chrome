{
  "name": "living-code-chrome",
  "version": "0.2.0",
  "description": "Living Code Night and Paper themes for Chrome and Chromium browsers.",
  "type": "module",
  "license": "MIT",
  "author": "Living Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/living-code-theme/chrome.git"
  },
  "homepage": "https://github.com/living-code-theme/chrome",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.22"
  },
  "livingCode": {
    "kind": "chrome"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test test/*.test.mjs",
    "build": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "screenshots": "nix develop path:./capture --command python3 scripts/capture.py",
    "screenshots:check": "python3 scripts/capture.py --check",
    "screenshots:store": "nix develop path:./capture --command node scripts/store-previews.mjs",
    "palette:update": "node scripts/update-palette.mjs",
    "package": "node scripts/package.mjs"
  }
}
